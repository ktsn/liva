{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite-plus/client"]
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "playground/vite.config.ts",
    "packages/**/*.vue"
  ],
  "exclude": ["packages/vite/wasm"],
  "contentMappers": [
    {
      "package": "vize",
      "extensions": [".vue"]
    }
  ]
}
