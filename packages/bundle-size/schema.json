{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ktsn/liva/blob/main/packages/bundle-size/schema.json",
  "title": "Liva production bundle measurement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "specification", "context", "base", "head"],
  "properties": {
    "schema": {
      "const": 1
    },
    "status": {
      "enum": ["success", "failure"]
    },
    "specification": {
      "$ref": "#/$defs/specification"
    },
    "context": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "pr",
            "baseBranch",
            "headRepository",
            "headBranch",
            "run",
            "attempt"
          ],
          "properties": {
            "repository": {
              "$ref": "#/$defs/ref"
            },
            "headRepository": {
              "$ref": "#/$defs/ref"
            },
            "baseBranch": {
              "$ref": "#/$defs/ref"
            },
            "headBranch": {
              "$ref": "#/$defs/ref"
            },
            "pr": {
              "$ref": "#/$defs/id"
            },
            "run": {
              "$ref": "#/$defs/id"
            },
            "attempt": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "base": {
      "$ref": "#/$defs/side"
    },
    "head": {
      "$ref": "#/$defs/side"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "base": {
            "$ref": "#/$defs/measurement"
          },
          "head": {
            "$ref": "#/$defs/measurement"
          }
        }
      },
      "else": {
        "anyOf": [
          {
            "properties": {
              "base": {
                "$ref": "#/$defs/failure"
              }
            }
          },
          {
            "properties": {
              "head": {
                "$ref": "#/$defs/failure"
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250,
      "pattern": "^[^\\u0000-\\u0020\\u007f]+$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safe": {
      "type": "string",
      "pattern": "^[A-Za-z0-9@._+/-]{1,200}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "node",
        "format",
        "target",
        "minifier",
        "sourcemap",
        "gzipLevel",
        "brotliQuality",
        "external",
        "fixture",
        "harness"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "node": {
          "const": "26.13.1"
        },
        "format": {
          "const": "es"
        },
        "target": {
          "const": "es2023"
        },
        "minifier": {
          "const": "oxc"
        },
        "sourcemap": {
          "const": false
        },
        "gzipLevel": {
          "const": 9
        },
        "brotliQuality": {
          "const": 11
        },
        "external": {
          "const": ["vue"]
        },
        "fixture": {
          "$ref": "#/$defs/hash"
        },
        "harness": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "side": {
      "oneOf": [
        {
          "$ref": "#/$defs/measurement"
        },
        {
          "$ref": "#/$defs/failure"
        }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "error"],
      "properties": {
        "sha": {
          "$ref": "#/$defs/sha"
        },
        "error": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "bytes", "bundle", "metadata"],
      "properties": {
        "sha": {
          "$ref": "#/$defs/sha"
        },
        "bundle": {
          "$ref": "#/$defs/hash"
        },
        "bytes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minified", "gzip", "brotli", "definitions"],
          "properties": {
            "minified": {
              "$ref": "#/$defs/bytes"
            },
            "gzip": {
              "$ref": "#/$defs/bytes"
            },
            "brotli": {
              "$ref": "#/$defs/bytes"
            },
            "definitions": {
              "$ref": "#/$defs/bytes"
            }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node",
            "rustc",
            "wasmBindgen",
            "packageManager",
            "zlib",
            "brotli",
            "vite",
            "rolldown",
            "dependencies",
            "lockfile",
            "cargoLockfile",
            "wasm",
            "oxc"
          ],
          "properties": {
            "node": {
              "const": "26.13.1"
            },
            "rustc": {
              "type": "string",
              "pattern": "^rustc [A-Za-z0-9 .()+-]{1,150}$"
            },
            "wasmBindgen": {
              "$ref": "#/$defs/safe"
            },
            "packageManager": {
              "$ref": "#/$defs/safe"
            },
            "zlib": {
              "$ref": "#/$defs/safe"
            },
            "brotli": {
              "$ref": "#/$defs/safe"
            },
            "vite": {
              "$ref": "#/$defs/safe"
            },
            "rolldown": {
              "$ref": "#/$defs/safe"
            },
            "lockfile": {
              "$ref": "#/$defs/hash"
            },
            "cargoLockfile": {
              "$ref": "#/$defs/hash"
            },
            "wasm": {
              "$ref": "#/$defs/hash"
            },
            "dependencies": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 100,
              "propertyNames": {
                "$ref": "#/$defs/safe"
              },
              "additionalProperties": {
                "$ref": "#/$defs/safe"
              }
            },
            "oxc": {
              "$ref": "#/$defs/safe"
            }
          }
        }
      }
    }
  }
}
