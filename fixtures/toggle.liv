toggle {
  state off {
    track {
      background-color: #888
    }

    thumb {
      translate: 0 0
      scale: 1
    }
  }

  state on {
    track {
      background-color: #34b27b
    }

    thumb {
      translate: 24px 0
      scale: 1
    }
  }

  transition {
    timing: tween(
      duration: 350ms,
      easing: ease-out
    )

    track {
      background-color {
        timing: tween(
          duration: 200ms,
          easing: ease-in-out
        )
      }
    }

    thumb {
      translate {
        timing: spring(
          stiffness: 300,
          damping: 20
        )
      }

      scale {
        40% {
          value: 1.3 1
          easing: ease-in
        }

        70% {
          value: 0.95 1
          easing: ease-out
        }
      }
    }
  }

  transition on -> off {
    thumb {
      translate {
        timing: spring(
          duration: 350ms,
          bounce: 0.25
        )
      }
    }
  }
}
