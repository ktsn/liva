{
  "schemaVersion": 3,
  "definitions": [
    {
      "name": "controller",
      "letBindings": [
        {
          "name": "pointer",
          "initializer": {
            "kind": "call",
            "function": "drag",
            "arguments": [
              {
                "name": "target",
                "value": {
                  "kind": "reference",
                  "path": ["self"]
                }
              }
            ]
          }
        },
        {
          "name": "movement",
          "initializer": {
            "kind": "call",
            "function": "link",
            "arguments": [
              {
                "name": "input",
                "value": {
                  "kind": "reference",
                  "path": ["pointer", "offset", "x"]
                }
              },
              {
                "name": "component",
                "value": {
                  "kind": "string",
                  "value": "x"
                }
              }
            ]
          }
        },
        {
          "name": "projected",
          "initializer": {
            "kind": "binary",
            "operator": "+",
            "left": {
              "kind": "reference",
              "path": ["movement", "value", "x"]
            },
            "right": {
              "kind": "binary",
              "operator": "*",
              "left": {
                "kind": "reference",
                "path": ["movement", "velocity", "x"]
              },
              "right": {
                "kind": "number",
                "value": 200
              }
            }
          }
        }
      ],
      "layers": [
        {
          "timingExpression": {
            "kind": "call",
            "function": "spring",
            "arguments": [
              {
                "name": "stiffness",
                "value": {
                  "kind": "number",
                  "value": 300
                }
              },
              {
                "name": "damping",
                "value": {
                  "kind": "number",
                  "value": 25
                }
              }
            ]
          },
          "transitions": [
            {
              "event": {
                "kind": "reference",
                "path": ["pointer", "release"]
              },
              "from": "closed",
              "to": "open",
              "when": {
                "kind": "binary",
                "operator": ">",
                "left": {
                  "kind": "reference",
                  "path": ["projected"]
                },
                "right": {
                  "kind": "number",
                  "value": 48
                }
              },
              "transition": {
                "targets": []
              }
            },
            {
              "event": {
                "kind": "reference",
                "path": ["pointer", "release"]
              },
              "from": "open",
              "to": "closed",
              "when": {
                "kind": "binary",
                "operator": "<=",
                "left": {
                  "kind": "reference",
                  "path": ["projected"]
                },
                "right": {
                  "kind": "number",
                  "value": 48
                }
              },
              "transition": {
                "targets": []
              }
            }
          ],
          "name": "position",
          "states": [
            {
              "name": "closed",
              "targets": []
            },
            {
              "name": "open",
              "targets": [
                {
                  "name": "self",
                  "properties": [
                    {
                      "name": "translate",
                      "value": {
                        "kind": "literal",
                        "value": "96px 0"
                      }
                    }
                  ]
                }
              ]
            }
          ],
          "initialState": "closed",
          "targets": [
            {
              "name": "self",
              "properties": [
                {
                  "name": "translate",
                  "value": {
                    "kind": "literal",
                    "value": "0 0"
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "dragging",
          "when": {
            "kind": "reference",
            "path": ["pointer", "active"]
          },
          "targets": [
            {
              "name": "self",
              "properties": [
                {
                  "name": "translate",
                  "value": {
                    "kind": "binding",
                    "expression": {
                      "kind": "reference",
                      "path": ["movement"]
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
