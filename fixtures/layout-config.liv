motion layoutConfig(active: boolean, duration: number) {
  let timing = tween(duration: duration)

  @timing
  layer base {
    $layout: position size
    opacity: 1
    content { $layout: y height @spring(stiffness: 300, damping: 25) }
  }

  layer active when active {
    self { $layout: position @instant }
  }

  layer phase {
    state off initial {}
    state on { content { $layout: none } }
    transition off -> on when active {
      @instant
      content { $layout ~> {} }
    }
  }
}
