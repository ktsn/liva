motion panel(open: boolean, distance: number) {
  layer base {
    content { opacity: 1; scale: 0.9; translate: 0px 0; border-radius: 0px }
    badge { opacity: 1 }
  }

  layer opened when open {
    content { scale: 1; border-radius: 20px }
  }

  enter {
    @tween(duration: 2000, easing: linear)
    content {
      opacity: 0
      scale: 0.8
      translate: ${distance}px 0
    }
    @tween(duration: 2000, easing: linear)
    badge { opacity: 0 }
  }

  leave {
    @tween(duration: 1000, easing: linear)
    content {
      opacity: 0
      scale: 1.2
      translate: ${distance}px 0
    }
    @tween(duration: 1000, easing: linear)
    badge { opacity: 0 }
  }
}
