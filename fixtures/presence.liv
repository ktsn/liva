motion swipe {
  let movement = drag(target: body)

  event dismiss when movement.released
    && movement.offset.x > 120
  event reset when !movement.active && movement.offset.x == 0

  state idle {
    body { translate: 0 0; opacity: 1 }
    badge { opacity: 1 }
  }
  state dragging when movement.active {
    body { translate: ${movement.offset.x}px 0 }
  }

  transition dragging -> idle {
    body { translate { @spring: 300 20 1 } }
  }

  enter {
    @tween: 0.25s ease-out
    body {
      opacity { 0%: 0 }
      translate { 0%: 0 -20px }
    }
    badge { opacity { @spring: 350ms 0.2; 0%: 0 } }
  }
  leave {
    @tween: 200ms ease-in
    body {
      opacity { 100%: 0 }
      translate { 100%: 500px 0 }
    }
    badge { opacity { @tween: 100ms; 100%: 0 } }
  }
}
