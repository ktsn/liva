motion swipe {
  let movement = drag(target: body)

  event dismiss when movement.released
    && movement.offset.x > 120
  event reset when !movement.active && movement.offset.x == 0

  layer interaction {
    body { translate: 0 0; opacity: 1 }
    badge { opacity: 1 }

    state idle initial {}
    state dragging { body { translate: ${movement.offset.x}px 0 } }

    transition idle -> dragging when movement.active
    transition dragging -> idle when !movement.active {
      body { translate @spring(stiffness: 300, damping: 20) {} }
    }
  }

  enter @tween(duration: 250, easing: easeOut) {
    body {
      opacity { 0%: 0 }
      translate { 0%: 0 -20px }
    }
    badge { opacity @spring(duration: 350, bounce: 0.2) { 0%: 0 } }
  }
  leave @tween(duration: 200, easing: easeIn) {
    body {
      opacity { 100%: 0 }
      translate { 100%: 500px 0 }
    }
    badge { opacity @tween(duration: 100) { 100%: 0 } }
  }
}
