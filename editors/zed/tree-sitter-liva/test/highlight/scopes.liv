  motion card(progress: number) {
//       ^ variable
    let movement = drag(target: body)
//                 ^ function
    layer active when movement.active {
//        ^ variable
      body {
//    ^ selector.class
        translate: ${movement.offset.x}px;
//      ^ property
//                 ^ punctuation.special
//                                    ^ punctuation.special
        @tween(duration: 300) scale ~> {
//                            ^ property
//      ^ attribute
          40%: 1.3 @cubicBezier(x1: 0.2, y1: 0.8, x2: 0.2, y2: 1);
//                 ^ attribute
          100%: 1
        }
      }
    }
  }

motion button {
  layer hover when true {
//^^^^^ keyword
//            ^^^^ keyword
    @tween(duration: 200) body {
//                        ^ selector.class
//  ^ attribute
      opacity: 1
    }
  }
  layer workflow {
    state idle initial {}
//             ^ keyword
    state busy {}
    transition idle -> busy when true
//  ^ keyword
  }
  enter { body { opacity: 0 } }
//^ keyword
}

motion animation(curve: easing, duration: timing) {
//                      ^ type
//                                        ^ type
  layer base {
    @tween(duration: 200, easing: easeOut) body {
//         ^ property
//                        ^ property
      opacity: 1
    }
  }
}

motion rooted {
  let movement = drag(target: self)
//                            ^ variable.builtin
  layer base {
    @spring() self {
//            ^ variable.builtin
      scale: 1
    }
    self: 1
//  ^ property
    icon {
//  ^ selector.class
      opacity: 1
    }
  }
}

motion swipe {
  let pointer = drag(target: self)
  let movement = link(input: pointer.offset.x, component: "x")
//               ^ function
  layer position {
    state closed initial {}
    state open {}
    on pointer.release {
//  ^^ keyword
      transition closed -> open when movement.value.x > 48
//    ^ keyword
    }
    translate := movement
//  ^ property
//            ^^ operator
  }
}

motion choices(axis: "x" | 'y', fixed: "") {
//                    ^ string
//                       ^ operator
//                          ^ string
//                                     ^ string
  layer base {}
}
