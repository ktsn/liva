  motion card(progress: number) {
//       ^ variable
    let movement = drag(target: body)
//                 ^ function
    state active when movement.active {
//        ^ variable
      body {
//    ^ selector.class
        translate: ${movement.offset.x}px;
//      ^ property
//                 ^ punctuation.special
//                                    ^ punctuation.special
      }
    }
    transition {
      body {
//    ^ selector.class
        scale {
//      ^ property
          @spring: 300 20 1;
//        ^ attribute
          40%: 1.3 @ cubic-bezier(0.2, 0.8, 0.2, 1);
//                 ^ attribute
//                   ^ function
        }
      }
    }
  }

motion button {
  layer hover when true {
//^^^^^ keyword
//            ^^^^ keyword
    body @tween(duration: 200) {
//  ^ selector.class
//       ^ attribute
      opacity: 1
    }
  }
  layer workflow {
    state idle initial {}
//             ^ keyword
    state busy {}
    transition idle -> busy when true
//  ^ keyword
  }
  enter { body { opacity: 0 } }
//^ keyword
}
