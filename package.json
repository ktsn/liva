{
  "name": "liva-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "test:wasm": "node scripts/test-wasm.ts",
    "check": "pnpm typecheck && vp run lint && vp run fmt:check",
    "test": "pnpm run test:coverage && pnpm run test:compatibility",
    "test:coverage": "vp test --run --project unit --project 'browser*' --project cross-browser-chromium",
    "test:compatibility": "vp test --run --project cross-browser-firefox --project cross-browser-webkit --coverage.enabled=false",
    "test:browser": "playwright test",
    "verify": "sh scripts/verify.sh",
    "build": "pnpm build:packages && pnpm --dir playground build",
    "build:packages": "vp run -t @liva/vite#build",
    "typecheck": "tsc --runExternalCode --noEmit && tsc --runExternalCode --noEmit -p playground/tsconfig.json",
    "size:measure": "node packages/bundle-size/src/cli.ts measure",
    "size:compare": "node packages/bundle-size/src/cli.ts compare"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.7",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vizejs/vite-plugin": "0.794.0",
    "typescript": "7.1.0-dev.20261125.1",
    "vite-plus": "1.6.0",
    "vize": "0.790.0"
  },
  "engines": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.23.0"
}
