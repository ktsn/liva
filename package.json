{
  "name": "liva-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "test:wasm": "node scripts/test-wasm.ts",
    "check": "pnpm typecheck && vp run lint && vp run fmt:check",
    "test": "vp test --run",
    "test:browser": "playwright test",
    "verify": "sh scripts/verify.sh",
    "build": "pnpm --dir playground build",
    "typecheck": "tsc --runExternalCode --noEmit && tsc --runExternalCode --noEmit -p playground/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vizejs/vite-plugin": "0.684.0",
    "typescript": "7.1.0-dev.20261102.1",
    "vite-plus": "1.4.0",
    "vize": "0.684.0"
  },
  "engines": {
    "node": "24.22.1"
  },
  "packageManager": "pnpm@12.4.2"
}
