{
  "name": "liva-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "test:wasm": "node scripts/test-wasm.ts",
    "check": "pnpm typecheck && vp run lint && vp run fmt:check",
    "test": "vp test --run",
    "test:browser": "playwright test",
    "verify": "sh scripts/verify.sh",
    "build": "pnpm --dir playground build",
    "typecheck": "tsc --runExternalCode --noEmit && tsc --runExternalCode --noEmit -p playground/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vizejs/vite-plugin": "0.732.0",
    "typescript": "7.1.0-dev.20261110.1",
    "vite-plus": "1.5.1",
    "vize": "0.751.0"
  },
  "engines": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.18.0"
}
